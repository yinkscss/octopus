{
  "name": "tauri-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev:clean": "pkill -f 'node .*node_modules/.bin/vite' || true; pkill -f 'target/debug/tauri-app' || true; tauri dev",
    "test": "vitest run",
    "test:phase2": "vitest run src/components/__tests__/Dashboard.alarms.test.tsx src/components/__tests__/WeeklyIntent.alarms.test.tsx src/lib/__tests__/commands.alarm.test.ts && npm run smoke:alarms",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval:goal-decomposer": "tsx src/llm/evals/goal_decomposer_eval.ts",
    "eval:alarm-engine": "tsx src/llm/evals/alarm_engine_eval.ts",
    "smoke:alarms": "tsx scripts/smoke/alarms-smoke.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.96.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^27.0.0",
    "msw": "^2.11.5",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
